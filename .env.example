DATABASE_URL=postgresql+psycopg://snowtrino:snowtrino@db:5432/snowtrino
INFRASTRUCTURE_MODE=mock
MOCK_TRINO_ENDPOINT=http://trino:8080
MOCK_TRINO_STARTUP_TIMEOUT_SECONDS=120
TERRAFORM_BINARY=terraform
TERRAFORM_ROOT=terraform
TERRAFORM_TIMEOUT_SECONDS=1800
TRINO_CONNECT_TIMEOUT_SECONDS=10
TRINO_QUERY_TIMEOUT_SECONDS=60
TRINO_MAX_RESULT_ROWS=1000
# AWS credentials should come from an IAM role or standard AWS credential chain.
# Never put access keys in this file.
